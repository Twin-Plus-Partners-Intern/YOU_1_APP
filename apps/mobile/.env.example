# Expo Public API Configuration (Points to remote or local Backend API Server)
# For Dev LAN, replace localhost with your machine's IP (e.g. 192.168.1.x)
EXPO_PUBLIC_API_URL=http://localhost:5000

# Expo Public Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Expo Public Google Gemini AI API Configuration
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
